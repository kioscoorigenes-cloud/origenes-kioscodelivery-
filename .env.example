# Plantilla de variables de entorno. Copiala a .env y completa los valores.
# El .env esta en .gitignore: NUNCA pongas valores reales en este archivo.

# GEMINI_API_KEY: necesaria para las llamadas a la API de Gemini (backend).
# En AI Studio se inyecta sola desde el panel de Secrets.
GEMINI_API_KEY=""

# APP_URL: URL publica donde esta hosteada la app.
# Se usa para links propios, callbacks de OAuth y endpoints.
APP_URL=""

# Integracion StarPOS (lado servidor).
# STARPOS_SERVICE_URL suele ser http://IP-DEL-LOCAL:8090 o un tunel ngrok.
STARPOS_USER_ID=""
STARPOS_SECRET=""
STARPOS_SERVICE_URL=""

# FIREBASE_SERVICE_ACCOUNT_JSON: JSON del service account de Firebase, en una
# sola linea y entre comillas SIMPLES (el JSON ya usa comillas dobles).
# El backend lo usa para verificar que quien llama a /api/* sea admin, para leer
# settings/billing y para resolver el envio gratis del primer pedido del dia.
# Si falta, las funciones de admin quedan bloqueadas a proposito (falla cerrado).
FIREBASE_SERVICE_ACCOUNT_JSON=''

# PORT lo inyecta la plataforma (Railway / Render / Fly). En local usa 3000.
